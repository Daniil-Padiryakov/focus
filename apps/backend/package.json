{
  "name": "@focus/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "// Development": "─────────────────────────────────────",
    "dev": "nest start --debug --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "// Build & Clean": "─────────────────────────────────────",
    "build": "nest build",
    "clean": "rm -rf dist",
    "// Code Quality": "─────────────────────────────────────",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "// Testing": "─────────────────────────────────────",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "// Database Migrations": "─────────────────────────────────────",
    "migration:create": "knex migrate:make --knexfile src/database/knexfile.ts -x ts",
    "migration:run": "knex migrate:latest --knexfile src/database/knexfile.ts",
    "migration:rollback": "knex migrate:rollback --knexfile src/database/knexfile.ts",
    "migration:status": "knex migrate:status --knexfile src/database/knexfile.ts",
    "migration:list": "knex migrate:list --knexfile src/database/knexfile.ts",
    "migration:unlock": "knex migrate:unlock --knexfile src/database/knexfile.ts",
    "migration:verify": "./src/database/scripts/verify-migrations.sh",
    "// Database Seeds": "─────────────────────────────────────",
    "seed:run": "knex seed:run --knexfile src/database/knexfile.ts",
    "seed:create": "knex seed:make --knexfile src/database/knexfile.ts -x ts",
    "// Database Utils": "─────────────────────────────────────",
    "db:analyze": "ts-node src/database/utils/analyze-cli.ts"
  },
  "dependencies": {
    "@focus/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@types/pg": "^8.15.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "joi": "^18.0.1",
    "knex": "^3.1.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jwt": "link:@types/@nestjs/jwt",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
