# ================================
# Environment Variables Template
# ================================
# Copy this file to .env.development and fill with actual values
# NEVER commit .env.development or .env.production to Git

# ================================
# Application
# ================================
NODE_ENV=development
PORT=3000

# ================================
# Database Configuration
# ================================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=focus_dev

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=10000
DATABASE_POOL_ACQUIRE_TIMEOUT=30000

# SSL (false for dev, true for prod)
DATABASE_SSL=false

# Debug mode (logs all SQL queries)
DATABASE_DEBUG=false

# ================================
# Authentication
# ================================
# JWT secret (minimum 32 characters, use random generator)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_MINIMUM_32_CHARACTERS

# JWT expiration (7d, 30d, 90d)
JWT_EXPIRES_IN=7d

# ================================
# Security
# ================================
# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ================================
# Logging
# ================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Pretty print logs (true for dev, false for prod)
LOG_PRETTY=true

# ================================
# Frontend (для Vite build)
# ================================
# Backend API URL (используется в production build)
VITE_API_URL=http://localhost:3000

# ================================
# External Services (опционально)
# ================================
# Email service
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password

# Redis (для caching/sessions)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# AWS S3 (для file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=my-bucket