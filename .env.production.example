# ================================
# Production Environment Template
# ================================
# Copy this file to .env.production and fill with actual values
# NEVER commit .env.production to Git

# ================================
# Project Configuration
# ================================
COMPOSE_PROJECT_NAME=focus-prod

# ================================
# Application
# ================================
NODE_ENV=production
PORT=3000

# ================================
# Database Configuration
# ================================
# Use managed database service in production (AWS RDS, DigitalOcean, etc.)
DATABASE_HOST=your-db-host.example.com
DATABASE_PORT=5432
DATABASE_USER=focus_prod_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=focus_production

# Connection Pool Settings (production optimized)
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_ACQUIRE_TIMEOUT=60000

# SSL (REQUIRED in production)
DATABASE_SSL=true

# Debug mode (MUST be false in production)
DATABASE_DEBUG=false

# ================================
# Authentication
# ================================
# CRITICAL: Generate strong random secret
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_STRONG_RANDOM_SECRET_MINIMUM_64_CHARACTERS_LONG

# JWT expiration (shorter in production for security)
JWT_EXPIRES_IN=7d

# ================================
# Security
# ================================
# Allowed CORS origins (production domains only)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting (stricter in production)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ================================
# Logging
# ================================
# Log level: info or warn in production (NOT debug)
LOG_LEVEL=info

# Pretty print logs (false for production - use JSON for log aggregation)
LOG_PRETTY=false

# ================================
# Frontend Build
# ================================
# Production API URL (full domain)
VITE_API_URL=https://api.yourdomain.com
API_URL=https://api.yourdomain.com

# ================================
# External Services (Production)
# ================================

# Email service (SendGrid, AWS SES, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM=noreply@yourdomain.com

# Redis (for caching/sessions - use managed service)
# REDIS_HOST=your-redis-host.example.com
# REDIS_PORT=6379
# REDIS_PASSWORD=strong-redis-password
# REDIS_TLS=true

# AWS S3 (for file uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=focus-production-uploads

# Monitoring & Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# ================================
# SSL/TLS Certificates (if using custom certs)
# ================================
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CA_PATH=/path/to/ca.pem
