# ================================
# Deploy to Kubernetes (Staging)
# ================================
# Triggers: Push to develop branch
# Target: Kubernetes staging cluster

name: Deploy to K8s Staging

on:
  push:
    branches:
      - develop
  workflow_dispatch:

env:
  REGISTRY: ghcr.io
  IMAGE_TAG: develop

jobs:
  deploy:
    name: Deploy to Staging Cluster
    runs-on: ubuntu-latest
    environment:
      name: staging
      url: https://staging.focus.yourdomain.com

    steps:
      # ================================
      # Checkout
      # ================================
      - name: Checkout code
        uses: actions/checkout@v4

      # ================================
      # Setup Kubernetes
      # ================================
      - name: Setup kubectl
        uses: azure/setup-kubectl@v4
        with:
          version: 'v1.28.0'

      - name: Configure kubeconfig
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.STAGING_KUBECONFIG }}" | base64 -d > ~/.kube/config
          chmod 600 ~/.kube/config

      - name: Verify cluster access
        run: |
          kubectl cluster-info
          kubectl get nodes

      # ================================
      # Update image tags
      # ================================
      - name: Update backend image
        run: |
          kubectl set image deployment/backend \
            backend=${{ env.REGISTRY }}/${{ github.repository }}/backend:${{ env.IMAGE_TAG }} \
            -n focus

      - name: Update frontend image
        run: |
          kubectl set image deployment/frontend \
            frontend=${{ env.REGISTRY }}/${{ github.repository }}/frontend:${{ env.IMAGE_TAG }} \
            -n focus

      # ================================
      # Wait for rollout
      # ================================
      - name: Wait for backend rollout
        run: |
          kubectl rollout status deployment/backend -n focus --timeout=5m

      - name: Wait for frontend rollout
        run: |
          kubectl rollout status deployment/frontend -n focus --timeout=3m

      # ================================
      # Run migrations
      # ================================
      - name: Run database migrations
        run: |
          # Get first backend pod
          POD=$(kubectl get pod -n focus -l app=backend -o jsonpath='{.items[0].metadata.name}')

          # Run migrations
          kubectl exec -n focus $POD -- pnpm --filter @focus/backend db:migrate

      # ================================
      # Health checks
      # ================================
      - name: Check deployment health
        run: |
          echo "Checking backend health..."
          kubectl wait --for=condition=ready pod -l app=backend -n focus --timeout=120s

          echo "Checking frontend health..."
          kubectl wait --for=condition=ready pod -l app=frontend -n focus --timeout=60s

          echo "✅ All pods are healthy"

      - name: Verify services
        run: |
          kubectl get pods -n focus
          kubectl get svc -n focus
          kubectl get ingress -n focus

      # ================================
      # Rollback on failure
      # ================================
      - name: Rollback on failure
        if: failure()
        run: |
          echo "❌ Deployment failed, rolling back..."

          # Rollback backend
          kubectl rollout undo deployment/backend -n focus

          # Rollback frontend
          kubectl rollout undo deployment/frontend -n focus

          echo "✅ Rollback completed"

      # ================================
      # Notifications
      # ================================
      - name: Notify team
        if: always()
        uses: 8398a7/action-slack@v3
        with:
          status: ${{ job.status }}
          text: |
            Staging K8s Deployment: ${{ job.status }}
            Branch: ${{ github.ref_name }}
            Commit: ${{ github.sha }}
            Author: ${{ github.actor }}
          webhook_url: ${{ secrets.SLACK_WEBHOOK }}
        continue-on-error: true
