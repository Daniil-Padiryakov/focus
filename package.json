{
  "name": "focus",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Full-stack monorepo with React, NestJS, and PostgreSQL",
  "scripts": {
    "// Development": "─────────────────────────────────────────────",
    "dev": "./scripts/dev.sh",
    "dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "restart": "pnpm down && pnpm dev",
    "reset": "./scripts/reset.sh",
    "clean": "pnpm -r clean && docker compose down -v",
    "// Production": "─────────────────────────────────────────────",
    "prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "prod:build": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "// Build & Install": "─────────────────────────────────────────────",
    "install:all": "pnpm install",
    "build:all": "pnpm -r build",
    "// Code Quality": "─────────────────────────────────────────────",
    "lint": "./scripts/lint-all.sh",
    "lint:all": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "quality": "./scripts/ci-checks.sh",
    "// Testing": "─────────────────────────────────────────────",
    "test:all": "pnpm -r test",
    "// Docker Logs & Health": "─────────────────────────────────────────────",
    "logs": "./scripts/logs.sh",
    "logs:backend": "./scripts/logs.sh backend",
    "logs:frontend": "./scripts/logs.sh frontend",
    "logs:postgres": "./scripts/logs.sh postgres",
    "health": "./scripts/health.sh",
    "// Docker Shell Access": "─────────────────────────────────────────────",
    "shell:backend": "docker compose exec backend sh",
    "shell:postgres": "docker compose exec postgres psql -U postgres -d focus_dev",
    "// Database Migrations": "─────────────────────────────────────────────",
    "db:migrate": "docker compose exec backend pnpm --filter @focus/backend migration:run",
    "db:migrate:make": "docker compose exec backend pnpm --filter @focus/backend migration:create",
    "db:migrate:rollback": "docker compose exec backend pnpm --filter @focus/backend migration:rollback",
    "db:migrate:status": "docker compose exec backend pnpm --filter @focus/backend migration:status",
    "db:migrate:list": "docker compose exec backend pnpm --filter @focus/backend migration:list",
    "// Database Seeds": "─────────────────────────────────────────────",
    "db:seed": "docker compose exec backend pnpm --filter @focus/backend seed:run",
    "db:seed:make": "docker compose exec backend pnpm --filter @focus/backend seed:create",
    "// Database Utils": "─────────────────────────────────────────────",
    "db:analyze": "docker compose exec backend pnpm --filter @focus/backend db:analyze",
    "db:reset": "pnpm db:migrate:rollback && pnpm db:migrate && pnpm db:seed",
    "db:psql": "docker compose exec -T postgres psql -U postgres -d focus_dev",
    "db:psql:interactive": "docker compose exec postgres psql -U postgres -d focus_dev",
    "db:logs": "docker compose logs postgres -f",
    "db:backup": "./docker/postgres/backup.sh",
    "db:restore": "./docker/postgres/restore.sh",
    "// Git Helpers": "─────────────────────────────────────────────",
    "git:feature": "./scripts/git/new-feature.sh",
    "git:sync": "./scripts/git/sync-develop.sh",
    "git:cleanup": "./scripts/git/cleanup-branches.sh",
    "// Git Hooks": "─────────────────────────────────────────────",
    "precommit": "lint-staged",
    "prepush": "pnpm typecheck",
    "prepare": "husky install"
  },
  "keywords": [
    "monorepo",
    "fullstack",
    "docker",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.18.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
