{
  "apps/backend/**/*.{ts,tsx}": [
    "bash -c 'cd apps/backend && pnpm exec eslint --fix'",
    "pnpm exec prettier --write"
  ],
  "apps/frontend/**/*.{ts,tsx}": [
    "bash -c 'cd apps/frontend && pnpm exec eslint \"{src,test}/**/*.{ts,tsx}\" --fix'",
    "pnpm exec prettier --write"
  ],
  "packages/**/*.{ts,tsx}": [
    "pnpm exec eslint --fix",
    "pnpm exec prettier --write"
  ],
  "package.json": [
    "prettier --write",
    "bash -c 'pnpm install --frozen-lockfile || true'"
  ]
}
